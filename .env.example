# Copy to `.env` for local development / release CI injection.
# Never commit real production values.

# --- Analytics ---
# AppMetrica application API key (client-embedded id — still keep out of git).
EXPO_PUBLIC_APPMETRICA_API_KEY=

# When "true", prefer console logging path in missing-key scenarios.
# Production releases should leave this false / unset.
EXPO_PUBLIC_ANALYTICS_DEV_MODE=false

# --- Advertising ---
# Production Yandex ad unit IDs (R-M-…).
# In __DEV__ the app ALWAYS uses official demo units.
EXPO_PUBLIC_YANDEX_ADS_BANNER_UNIT_ID=

# Reserved for future rewarded — Tile v1 does NOT show rewarded ads.
EXPO_PUBLIC_YANDEX_ADS_REWARDED_UNIT_ID=
